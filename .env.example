# MongoDB connection string. Atlas (cloud) or a local mongod both work.
DATABASE_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/leakcheck

# A long random string. Used to sign Payload admin sessions. Keep it secret.
PAYLOAD_SECRET=your-random-secret-here

# Where the app is served from. Used for CORS/CSRF and the admin panel.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# ---- Email (optional) ----
# Fill these in to email the report to the lead and a notification to Henry on submit.
# Leave SMTP_HOST blank to keep email off. Works with any SMTP provider
# (e.g. Gmail with an App Password, Zoho, Brevo, Mailgun...).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
EMAIL_TO=hampey88@gmail.com

# ---- Google Sheets mirror (optional) ----
# Paste the Apps Script web app URL (ends in /exec) to also append each lead to a sheet.
# Leave blank to keep the mirror off. See integrations/google-apps-script.gs.
SHEET_WEBHOOK_URL=
